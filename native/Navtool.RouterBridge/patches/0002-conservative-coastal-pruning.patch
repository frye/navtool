+using namespace environment_detail;
+constexpr double radius = detail::earth_radius_nautical_miles;
+
+std::size_t retained_overhead(const CoastalTopologyOptions& options) {
+    return sizeof(CoastalTopology) + options.source_identity.size() + options.domain_identity.size() + 2U;
+}
+
+std::optional<Error> validate(const CoastalTopologyOptions& options) {
+    if (options.cancelled && options.cancelled())
+        return Error{ErrorCode::cancelled, "coastal topology preparation cancelled"};
+    if (options.source_identity.empty() || options.domain_identity.empty() ||
+        (options.polygon_edges != CoastalPolygonEdges::great_circle &&
+         options.polygon_edges != CoastalPolygonEdges::linear_latitude_longitude) ||
+        !std::isfinite(options.clearance_nautical_miles) || options.clearance_nautical_miles < 0.0 ||
+        !std::isfinite(options.numerical_margin_nautical_miles) ||
+        options.numerical_margin_nautical_miles < 1.0e-4 ||
+        options.source_identity.size() > 4096U || options.domain_identity.size() > 4096U ||
+        options.maximum_caps == 0U || options.maximum_work == 0U ||
+        options.maximum_bytes < retained_overhead(options)) {
+        return Error{ErrorCode::invalid_argument, "invalid coastal topology identity, uncertainty or budget"};
+    }
+    const auto& d = options.domain;
+    if (!d.south_latitude_degrees || !d.north_latitude_degrees ||
+        !is_valid({*d.south_latitude_degrees, 0.0}) || !is_valid({*d.north_latitude_degrees, 0.0}) ||
+        *d.south_latitude_degrees >= *d.north_latitude_degrees || d.first_valid_time || d.last_valid_time ||
+        (!d.global_longitude_coverage && (!d.west_longitude_degrees || !d.east_longitude_degrees ||
+            !is_valid({0.0, *d.west_longitude_degrees}) || !is_valid({0.0, *d.east_longitude_degrees}) ||
+            *d.west_longitude_degrees == *d.east_longitude_degrees))) {
+        return Error{ErrorCode::invalid_argument, "coastal topology needs a nonempty static geographic domain"};
+    }
+    return std::nullopt;
+}
+
+double coverage_radius(Coordinate p, const EnvironmentCoverage& d) {
+    if (p.latitude_degrees < *d.south_latitude_degrees || p.latitude_degrees > *d.north_latitude_degrees)
+        return 0.0;
+    constexpr double radians = std::numbers::pi / 180.0;
+    double bound = radius * std::numbers::pi;
+    if (*d.south_latitude_degrees > -90.0)
+        bound = std::min(bound, radius * radians * (p.latitude_degrees - *d.south_latitude_degrees));
+    if (*d.north_latitude_degrees < 90.0)
+        bound = std::min(bound, radius * radians * (*d.north_latitude_degrees - p.latitude_degrees));
+    if (!d.global_longitude_coverage) {
+        const double width = detail::normalize_degrees(*d.east_longitude_degrees - *d.west_longitude_degrees);
+        if (detail::normalize_degrees(p.longitude_degrees - *d.west_longitude_degrees) > width) return 0.0;
+        for (double longitude : {*d.west_longitude_degrees, *d.east_longitude_degrees}) {
+            const double distance = std::asin(std::abs(std::cos(p.latitude_degrees*radians) *
+                std::sin((p.longitude_degrees-longitude)*radians))) * radius;
+            bound = std::min(bound, distance);
+        }
+    }
+    return bound;
+}
+
+enum class Containment { outside, inside, unknown };
+struct ProofPolygon {
+    std::vector<UnitVector> outer;
+    std::vector<std::vector<UnitVector>> holes;
+};
+
+Containment classify_certified(std::span<const UnitVector> ring, UnitVector p) {
+    UnitVector centroid{};
+    double winding = 0.0;
+    for (std::size_t i=0; i<ring.size(); ++i) {
+        const auto a = ring[i];
+        const auto b = ring[(i+1U)%ring.size()];
+        centroid = add(centroid,a);
+        winding += std::atan2(dot(p,cross(a,b)), dot(a,b)-dot(p,a)*dot(p,b));
+    }
+    // The hemisphere proof applies only to the validator's normalized ring,
+    // never to the duplicate-weighted centroid of the original input.
+    if (dot(p,normalize(centroid)) <= 0.0) return Containment::outside;
+    if (!std::isfinite(winding)) return Containment::unknown;
+    if (std::abs(winding) < 1.0e-6) return Containment::outside;
+    if (std::abs(std::abs(winding)-2.0*std::numbers::pi) < 1.0e-6) return Containment::inside;
+    return Containment::unknown;
+}
+
+bool certified_land(const std::vector<ProofPolygon>& polygons, UnitVector p) {
+    for (const auto& polygon : polygons) {
+        if (classify_certified(polygon.outer,p) != Containment::inside) continue;
+        bool clear_of_holes = true;
+        for (const auto& hole : polygon.holes)
+            if (classify_certified(hole,p) != Containment::outside) clear_of_holes = false;
+        if (clear_of_holes) return true;
+    }
+    return false;
+}
+
+// Shortest path in R^3 outside one closed ball. Every legal spherical water
+// path is in this larger ambient set; taking the maximum over single balls,
+// never their sum, preserves a lower bound.
+double ball_distance(UnitVector a, UnitVector b, UnitVector center, double r) {
+    const auto u = add(a, negate(center)), v = add(b, negate(center));
+    const double x = norm(u), y = norm(v);
+    if (x <= r || y <= r) return 0.0;
+    const double angle = std::acos(std::clamp(dot(u, v) / (x * y), -1.0, 1.0));
+    const double tangent_a = std::acos(std::clamp(r / x, 0.0, 1.0));
+    const double tangent_b = std::acos(std::clamp(r / y, 0.0, 1.0));
+    if (angle <= tangent_a + tangent_b) return norm(add(a, negate(b)));
+    return std::sqrt(std::max(0.0, x*x-r*r)) +
+        std::sqrt(std::max(0.0, y*y-r*r)) + r*(angle-tangent_a-tangent_b);
+}
+}
+
+Result<std::shared_ptr<const CoastalTopology>> CoastalTopology::from_certified_caps(
+    std::vector<Cap> caps, CoastalTopologyOptions options) {
+    if (auto error = validate(options)) return *error;
+    if (caps.size() > options.maximum_caps || caps.size() > options.maximum_work ||
+        caps.size() > (options.maximum_bytes - retained_overhead(options)) / sizeof(Cap)) {
+        return Error{ErrorCode::resource_limit, "certified coastal cap budget exceeded"};
+    }
+    auto result = std::shared_ptr<CoastalTopology>(new CoastalTopology);
+    result->options_ = std::move(options);
+    result->certified_caps_ = true;
+    result->caps_.reserve(caps.size());
+    const auto& domain = result->options_.domain;
+    for (auto cap : caps) {
+        if (result->options_.cancelled && result->options_.cancelled())
+            return Error{ErrorCode::cancelled, "certified coastal cap preparation cancelled"};
+        ++result->work_;
+        if (!is_valid(cap.center) || !std::isfinite(cap.radius_nautical_miles) ||
+            cap.radius_nautical_miles <= 0.0 || cap.radius_nautical_miles >= radius * std::numbers::pi / 2.0) {
+            return Error{ErrorCode::invalid_argument, "certified coastal cap requires canonical center and radius in (0, hemisphere)"};
+        }
+        if (cap.center.latitude_degrees < *domain.south_latitude_degrees ||
+            cap.center.latitude_degrees > *domain.north_latitude_degrees ||
+            (!domain.global_longitude_coverage &&
+             detail::normalize_degrees(cap.center.longitude_degrees - *domain.west_longitude_degrees) >
+                 detail::normalize_degrees(*domain.east_longitude_degrees - *domain.west_longitude_degrees))) {
+            return Error{ErrorCode::invalid_argument, "certified coastal cap center is outside preparation coverage"};
+        }
+        cap.radius_nautical_miles -= result->options_.numerical_margin_nautical_miles;
+        if (cap.radius_nautical_miles > coverage_radius(cap.center, domain))
+            return Error{ErrorCode::invalid_argument, "certified coastal cap extends outside preparation coverage"};
+        if (cap.radius_nautical_miles > 0.0) result->caps_.push_back(cap);
+    }
+    result->options_.cancelled = {};
+    return std::shared_ptr<const CoastalTopology>{std::move(result)};
+}
+
+Result<std::shared_ptr<const CoastalTopology>> CoastalTopology::from_polygons(
+    std::vector<ExclusionPolygon> polygons, std::span<const Coordinate> probes,
+    CoastalTopologyOptions options) {
+    if (auto error = validate(options)) return *error;
+    std::size_t vertices = 0U;
+    std::size_t preparation_work = 0U;
+    double edge_relaxation = 0.0;
+    const auto measure_edges = [&](const ExclusionRing& ring) {
+        if (options.polygon_edges != CoastalPolygonEdges::linear_latitude_longitude) return;
+        for (std::size_t i = 0; i < ring.vertices.size(); ++i) {
+            const auto a = ring.vertices[i], b = ring.vertices[(i+1U)%ring.vertices.size()];
+            // A latitude-then-longitude path upper-bounds the linear edge
+            // length. Its homotopy to the minor spherical edge stays in the
+            // convex endpoint cap of this radius. Erode by that whole radius.
+            edge_relaxation = std::max(edge_relaxation, radius * std::numbers::pi / 180.0 *
+                (std::abs(a.latitude_degrees-b.latitude_degrees) +
+                 detail::angular_difference_degrees(a.longitude_degrees,b.longitude_degrees)));
+        }
+    };
+    for (const auto& polygon : polygons) {
+        if (options.cancelled && options.cancelled())
+            return Error{ErrorCode::cancelled, "coastal topology preparation cancelled"};
+        if (polygon.outer.vertices.size() < 3U)
+            return Error{ErrorCode::invalid_environment, "coastal polygon requires a complete outer ring"};
+        if (polygon.outer.vertices.size() > options.maximum_work - vertices)
+            return Error{ErrorCode::resource_limit, "coastal vertex budget exceeded"};
+        vertices += polygon.outer.vertices.size();
+        measure_edges(polygon.outer);
+        if (polygon.outer.vertices.size() > (options.maximum_work - preparation_work) / 64U)
+            return Error{ErrorCode::resource_limit, "coastal validation budget exceeded"};
+        preparation_work += polygon.outer.vertices.size() * 64U;
+        for (const auto& hole : polygon.holes) {
+            if (hole.vertices.size() < 3U)
+                return Error{ErrorCode::invalid_environment, "coastal polygon requires complete hole rings"};
+            if (hole.vertices.size() > options.maximum_work - vertices)
+                return Error{ErrorCode::resource_limit, "coastal vertex budget exceeded"};
+            vertices += hole.vertices.size();
+            measure_edges(hole);
+            const auto per_vertex = 64U + 8U * polygon.outer.vertices.size();
+            if (hole.vertices.size() > (options.maximum_work - preparation_work) / per_vertex)
+                return Error{ErrorCode::resource_limit, "coastal hole validation budget exceeded"};
+            preparation_work += hole.vertices.size() * per_vertex;
+        }
+    }
+    // Includes validation's pairwise hole/outer containment work and scratch
+    // storage, not just the retained caps. Charge a conservative upper budget.
+    if (vertices > options.maximum_bytes / (32U * sizeof(Coordinate))) {
+        return Error{ErrorCode::resource_limit, "coastal polygon preparation budget exceeded"};
+    }
+    if (options.cancelled && options.cancelled())
+        return Error{ErrorCode::cancelled, "coastal topology preparation cancelled"};
+    if (polygons.empty()) {
+        auto empty = std::shared_ptr<CoastalTopology>(new CoastalTopology);
+        options.cancelled = {};
+        empty->options_ = std::move(options);
+        return std::shared_ptr<const CoastalTopology>{std::move(empty)};
+    }
+    ExclusionZone zone;
+    zone.identifier = "coastal-proof";
+    zone.polygons = std::move(polygons);
+    auto geometry = ExclusionZoneSet::create({std::move(zone)}, {"coastal-proof", options.source_identity, "1"});
+    if (!geometry) return geometry.error();
+    std::vector<ProofPolygon> proof_polygons;
+    for (const auto& polygon : geometry.value().zones().front().polygons) {
+        if (options.cancelled && options.cancelled())
+            return Error{ErrorCode::cancelled, "coastal topology preparation cancelled"};
+        auto outer = normalize_ring_vertices(polygon.outer.vertices);
+        if (!outer) return outer.error();
+        ProofPolygon proof{std::move(outer.value()), {}};
+        for (const auto& hole : polygon.holes) {
+            if (options.cancelled && options.cancelled())
+                return Error{ErrorCode::cancelled, "coastal topology preparation cancelled"};
+            auto normalized = normalize_ring_vertices(hole.vertices);
+            if (!normalized) return normalized.error();
+            proof.holes.push_back(std::move(normalized.value()));
+        }
+        proof_polygons.push_back(std::move(proof));
+    }
+    auto result = std::shared_ptr<CoastalTopology>(new CoastalTopology);
+    result->options_ = std::move(options);
+    result->work_ = preparation_work;
+    const std::size_t cap_limit = std::min(result->options_.maximum_caps,
+        (result->options_.maximum_bytes - retained_overhead(result->options_)) / sizeof(Cap));
+    result->caps_.reserve(cap_limit);
+    for (const auto probe : probes) {
+        if (result->options_.cancelled && result->options_.cancelled())
+            return Error{ErrorCode::cancelled, "coastal topology preparation cancelled"};
+        if (!is_valid(probe)) return Error{ErrorCode::invalid_argument, "invalid coastal probe"};
+        if (32U*vertices + 1U > result->options_.maximum_work - result->work_)
+            return Error{ErrorCode::resource_limit, "coastal topology work budget exceeded"};
+        result->work_ += 32U*vertices + 1U;
+        double distance = std::numeric_limits<double>::infinity();
+        const auto p = to_unit_vector(probe);
+        const auto ring_distance = [&](std::span<const UnitVector> ring) {
+            for (std::size_t i=0; i<ring.size(); ++i)
+                distance = std::min(distance, radius * distance_to_arc(p,
+                    ring[i], ring[(i+1U)%ring.size()]));
+        };
+        for (const auto& polygon : proof_polygons) {
+            ring_distance(polygon.outer);
+            for (const auto& hole : polygon.holes) ring_distance(hole);
+        }
+        distance = std::min(distance, coverage_radius(probe, result->options_.domain)) -
+            result->options_.numerical_margin_nautical_miles - edge_relaxation;
+        if (edge_relaxation >= radius * std::numbers::pi / 2.0) distance = 0.0;
+        if (distance <= 0.0 || !certified_land(proof_polygons,p)) continue;
+        if (distance > 0.0 && distance < radius && result->caps_.size() < cap_limit)
+            result->caps_.push_back({probe, distance});
+        if (result->caps_.size() >= cap_limit) { result->limited_ = true; break; }
+    }
+    result->options_.cancelled = {};
+    return std::shared_ptr<const CoastalTopology>{std::move(result)};
+}
+
+Result<std::shared_ptr<const CoastalTopology>> CoastalTopology::from_landmask(
+    const SignedDistanceLandmask& landmask, std::span<const Coordinate> probes,
+    CoastalTopologyOptions options) {
+    if (auto error = validate(options)) return *error;
+    const auto& grid = landmask.grid();
+    if (grid.latitude_count < 2U || grid.longitude_count < 2U)
+        return Error{ErrorCode::invalid_argument, "coastal topology requires a populated signed-distance grid"};
+    EnvironmentCoverage coverage;
+    coverage.south_latitude_degrees = grid.south_latitude_degrees;
+    coverage.north_latitude_degrees = grid.south_latitude_degrees +
+        grid.latitude_step_degrees * static_cast<double>(grid.latitude_count-1U);
+    coverage.west_longitude_degrees = grid.west_longitude_degrees;
+    coverage.east_longitude_degrees = detail::normalize_degrees(grid.west_longitude_degrees +
+        grid.longitude_step_degrees * static_cast<double>(grid.longitude_count-1U) + 180.0) - 180.0;
+    coverage.global_longitude_coverage = grid.global_longitude_coverage;
+    auto result = std::shared_ptr<CoastalTopology>(new CoastalTopology);
+    result->options_ = std::move(options);
+    result->native_ = true;
+    result->landmask_ = landmask;
+    const std::size_t cap_limit = std::min(result->options_.maximum_caps,
+        (result->options_.maximum_bytes - retained_overhead(result->options_)) / sizeof(Cap));
+    result->caps_.reserve(cap_limit);
+    for (const auto probe : probes) {
+        if (result->options_.cancelled && result->options_.cancelled())
+            return Error{ErrorCode::cancelled, "coastal topology preparation cancelled"};
+        if (!is_valid(probe)) return Error{ErrorCode::invalid_argument, "invalid coastal probe"};
+        if (++result->work_ > result->options_.maximum_work)
+            return Error{ErrorCode::resource_limit, "coastal topology work budget exceeded"};
+        const auto value = landmask.signed_distance_nautical_miles(probe);
+        if (!value.has_value()) {
+            if (value.status == EnvironmentSampleStatus::invalid_data)
+                return Error{ErrorCode::invalid_argument, "invalid coastal land distance"};
+            continue;
+        }
+        const double distance = std::min({-value.value - landmask.metadata().interpolation_error_nautical_miles,
+            coverage_radius(probe, result->options_.domain), coverage_radius(probe,coverage)}) -
+            result->options_.numerical_margin_nautical_miles;
+        if (distance > 0.0 && distance < radius && result->caps_.size() < cap_limit)
+            result->caps_.push_back({probe, distance});
+        if (result->caps_.size() >= cap_limit) { result->limited_ = true; break; }
+    }
+    result->options_.cancelled = {};
+    return std::shared_ptr<const CoastalTopology>{std::move(result)};
+}
+
+double CoastalTopology::optimistic_distance_nautical_miles(
+    Coordinate from, Coordinate destination, double arrival_radius, double transition_relaxation) const noexcept {
+    if (!is_valid(from) || !is_valid(destination) || !std::isfinite(arrival_radius) || arrival_radius < 0.0 ||
+        !std::isfinite(transition_relaxation) || transition_relaxation < 0.0)
+        return 0.0;
+    const auto a = scale(to_unit_vector(from), radius), b = scale(to_unit_vector(destination), radius);
+    double distance = std::max(0.0, detail::great_circle_distance_nautical_miles(from, destination) - arrival_radius);
+    for (const auto& cap : caps_) {
+        const double cap_radius = cap.radius_nautical_miles - transition_relaxation;
+        if (cap_radius <= 0.0) continue;
+        const auto center = scale(to_unit_vector(cap.center), radius);
+        const double r = 2.0*radius*std::sin(cap_radius/(2.0*radius));
+        // The entire Euclidean arrival ball must avoid the obstacle. Only
+        // then may its radius be subtracted using a legal straight connector.
+        if (norm(add(b, negate(center))) <= r + arrival_radius) continue;
+        distance = std::max(distance, ball_distance(a, b, center, r) - arrival_radius);
+    }
+    return std::max(0.0, distance - options_.numerical_margin_nautical_miles);
+}
