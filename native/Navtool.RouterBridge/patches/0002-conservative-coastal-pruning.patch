+enum class CoastalPruningMode { off, conservative };
+enum class CoastalBoundStatus { available, unavailable, disabled };
+struct CoastalRemainingBound {
+    double optimistic_seconds{};
+    CoastalBoundStatus status{CoastalBoundStatus::unavailable};
+    std::string reason;
+    std::optional<double> speed_upper_knots;
+};
+
+/// Hold a water-relative heading for a bounded duration; maneuver time is
+/// included in that duration. Arrival may terminate the action early.
+struct SailingAction {
+    double heading_degrees{};
+    std::chrono::seconds duration{};
+};
+
+struct CoastalPruningOptions {
+    CoastalPruningMode mode{CoastalPruningMode::off};
+    std::shared_ptr<const CoastalTopology> topology;
+    std::string source_identity;
+    std::string domain_identity;
+    double clearance_nautical_miles{};
+    /// Empty proposes one destination-bearing action; failure is normal.
+    std::vector<SailingAction> seed_actions;
+    std::size_t maximum_seed_transitions{512U};
+    /// Optional thread-safe cancellation probe, including seed validation.
+    std::function<bool()> cancelled;
+};
+
+struct CoastalPruningDiagnostics {
+    CoastalPruningMode requested{CoastalPruningMode::off};
+    CoastalPruningMode effective{CoastalPruningMode::off};
+    std::string source_identity;
+    std::string domain_identity;
+    std::string bound_status;
+    std::string seed_status;
+    std::optional<double> speed_upper_knots;
+    std::optional<TimePoint> incumbent_arrival;
+    std::size_t parent_expansions_skipped{};
+    std::size_t candidates_disconnected{};
+    std::size_t candidates_horizon{};
+    std::size_t candidates_incumbent{};
+    std::size_t bound_unavailable{};
+    std::size_t seed_transition_evaluations{};
+    std::size_t topology_work{};
