+TEST_CASE("coastal invalid seed is never an incumbent and cancellation remains an error") {
+    const test::ConstantWindGribFixture fixture;
+    const auto weather = WeatherDataset::load(fixture.path());
+    REQUIRE(weather.has_value());
+    Router router{weather.value()};
+    auto request = route_request(weather.value());
+    request.options.segment_eligibility = [](const auto&) { return true; };
+    enable(request, topology({rectangle(-2,-2,-1,-1)}));
+    request.options.coastal_pruning.maximum_seed_transitions = 1U;
+    auto result = router.optimize(request);
+    REQUIRE(result.has_value());
+    REQUIRE(result.value().diagnostics.coastal_pruning->seed_status == "budget_exhausted");
+    REQUIRE(result.value().diagnostics.coastal_pruning->seed_transition_evaluations == 1U);
+    auto cancelled = router.optimize_view(request, [](const RoutingProgressView&) {
+        return RoutingProgressDecision::cancel;
+    });
+    REQUIRE(!cancelled && cancelled.error().code == ErrorCode::cancelled);
+    request.options.coastal_pruning.cancelled = [] { return true; };
+    cancelled = router.optimize(request);
+    REQUIRE(!cancelled && cancelled.error().code == ErrorCode::cancelled);
+}
