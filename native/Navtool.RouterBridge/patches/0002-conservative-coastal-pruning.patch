+TEST_CASE("coastal linear longitude latitude polygons use certified erosion not spherical substitution") {
+    auto polygon = rectangle(-0.2,-0.2,0.2,0.2);
+    const auto corners = polygon.outer.vertices;
+    polygon.outer.vertices.clear();
+    for (std::size_t edge=0; edge<4U; ++edge) {
+        const auto a = corners[edge], b = corners[(edge+1U)%4U];
+        for (int step=0; step<8; ++step) {
+            const double f = static_cast<double>(step)/8.0;
+            polygon.outer.vertices.push_back({a.latitude_degrees + f*(b.latitude_degrees-a.latitude_degrees),
+                a.longitude_degrees + f*(b.longitude_degrees-a.longitude_degrees)});
+        }
+    }
+    auto options = topology_options();
+    options.polygon_edges = CoastalPolygonEdges::linear_latitude_longitude;
+    const std::array<Coordinate,1> probes{{{0,0}}};
+    auto linear = CoastalTopology::from_polygons({polygon}, probes, options);
+    REQUIRE(linear.has_value());
+    REQUIRE(linear.value()->cap_count() == 1U);
+    const auto spherical = topology({polygon}, {{0,0}});
+    const Coordinate a{0,-0.5}, b{0,0.5};
+    const double direct = detail::great_circle_distance_nautical_miles(a,b);
+    const double h = linear.value()->optimistic_distance_nautical_miles(a,b,0.0,1.0);
+    REQUIRE(h > direct);
+    REQUIRE(h <= spherical->optimistic_distance_nautical_miles(a,b,0.0));
+    REQUIRE(linear.value()->optimistic_distance_nautical_miles(a,b,0.0,100.0) <= direct);
+}
