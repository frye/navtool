@@ -0,0 +1,80 @@
+#pragma once
+
+#include "sailroute/environment.hpp"
+
+namespace sailroute {
+
+inline constexpr unsigned coastal_pruning_api_version = 1U;
+[[nodiscard]] constexpr bool supports_coastal_pruning(RoutingSolver solver) noexcept {
+    return solver == RoutingSolver::isochrone_beam;
+}
+
+enum class CoastalPolygonEdges { great_circle, linear_latitude_longitude };
+
+struct CoastalTopologyOptions {
+    std::string source_identity;
+    std::string domain_identity;
+    /// Preparation coverage only; outside remains potentially navigable.
+    EnvironmentCoverage domain{-90.0, 90.0, {}, {}, {}, {}, true};
+    CoastalPolygonEdges polygon_edges{CoastalPolygonEdges::great_circle};
+    double clearance_nautical_miles{};
+    double numerical_margin_nautical_miles{1.0e-4};
+    std::size_t maximum_work{1'000'000U};
+    std::size_t maximum_caps{1024U};
+    std::size_t maximum_bytes{4U * 1024U * 1024U};
+    std::function<bool()> cancelled;
+};
+
+/// Immutable, concurrently queryable relaxation. No disconnection claims or
+/// implicit domain clipping. Regions not represented by caps remain open.
+/// Polygon edges MUST select the same semantics as enforcement; linear edges
+/// use shortest wrapped longitude interpolation. In linear mode enforcement
+/// must reject endpoints in these polygons at every physical integration step.
+/// Caller certifies source/domain identity and that polygons are permanently
+/// forbidden by its callback; arbitrary callback topology cannot be inferred.
+class CoastalTopology {
+public:
+    struct Cap { Coordinate center; double radius_nautical_miles; };
+    /// Caller certifies every cap is permanently forbidden by the selected
+    /// enforcement contract, including its sampling/numerical uncertainty.
+    /// Native validation checks shape, identity, domain and budgets, NOT that
+    /// the application's geometric proof is true. The numerical margin is
+    /// additionally subtracted so an open-cap certificate suffices.
+    [[nodiscard]] static Result<std::shared_ptr<const CoastalTopology>> from_certified_caps(
+        std::vector<Cap> caps, CoastalTopologyOptions options);
+    [[nodiscard]] static Result<std::shared_ptr<const CoastalTopology>> from_polygons(
+        std::vector<ExclusionPolygon> polygons,
+        std::span<const Coordinate> probes,
+        CoastalTopologyOptions options);
+    [[nodiscard]] static Result<std::shared_ptr<const CoastalTopology>> from_landmask(
+        const SignedDistanceLandmask& landmask,
+        std::span<const Coordinate> probes,
+        CoastalTopologyOptions options);
+    [[nodiscard]] double optimistic_distance_nautical_miles(
+        Coordinate from, Coordinate destination, double arrival_radius,
+        double transition_relaxation_nautical_miles = 0.0) const noexcept;
+    [[nodiscard]] const CoastalTopologyOptions& options() const noexcept { return options_; }
+    [[nodiscard]] std::size_t construction_work() const noexcept { return work_; }
+    [[nodiscard]] std::size_t cap_count() const noexcept { return caps_.size(); }
+    [[nodiscard]] bool construction_limited() const noexcept { return limited_; }
+    [[nodiscard]] bool native_landmask() const noexcept { return native_; }
+    [[nodiscard]] bool caller_certified_caps() const noexcept { return certified_caps_; }
+    [[nodiscard]] const ProviderMetadata& provider() const noexcept {
+        return landmask_ ? landmask_->metadata().provider : provider_;
+    }
+    [[nodiscard]] bool matches_landmask(const SignedDistanceLandmask& mask) const noexcept {
+        return landmask_ && landmask_->shares_data_with(mask);
+    }
+
+private:
+    CoastalTopologyOptions options_;
+    std::vector<Cap> caps_;
+    std::size_t work_{};
+    bool native_{};
+    bool certified_caps_{};
+    bool limited_{};
+    ProviderMetadata provider_;
+    std::optional<SignedDistanceLandmask> landmask_;
+};
+
+} // namespace sailroute
