+TEST_CASE("coastal duplicate ring normalization never fills water holes") {
+    const auto subdivide = [](ExclusionRing ring) {
+        const auto corners = ring.vertices;
+        ring.vertices.clear();
+        for (std::size_t edge = 0; edge < corners.size(); ++edge) {
+            const auto a = corners[edge], b = corners[(edge + 1U) % corners.size()];
+            for (int step = 0; step < 20; ++step) {
+                const double fraction = static_cast<double>(step) / 20.0;
+                ring.vertices.push_back({
+                    a.latitude_degrees + fraction * (b.latitude_degrees - a.latitude_degrees),
+                    a.longitude_degrees + fraction * (b.longitude_degrees - a.longitude_degrees)});
+            }
+        }
+        return ring;
+    };
+    ExclusionPolygon plain{
+        subdivide(rectangle(-20,-65,20,65).outer),
+        {subdivide(rectangle(-10,-55,10,55).outer)}};
+    const Coordinate from{-9,50}, to{9,50}, water_probe{0,50}, land_probe{15,50};
+    const double legal_distance = detail::great_circle_distance_nautical_miles(from,to);
+    const auto reference = topology({plain}, {water_probe});
+    REQUIRE(reference->cap_count() == 0U);
+    const auto reference_land = topology({plain}, {water_probe,land_probe});
+    REQUIRE(reference_land->cap_count() == 1U);
+
+    for (int variant = 0; variant < 3; ++variant) {
+        auto repeated = plain;
+        auto& hole = repeated.holes.front().vertices;
+        const auto southwest = hole.front();
+        // Exact review reproducer: 400 copies of the hole's SW vertex skewed
+        // the raw centroid opposite the validated, duplicate-free centroid.
+        hole.insert(hole.begin(), 400U, southwest);
+        if (variant > 0) {
+            hole.insert(hole.end(), 40U, southwest);
+            auto& outer = repeated.outer.vertices;
+            const auto first = outer.front();
+            outer.insert(outer.begin(), 400U, first);
+            outer.insert(outer.end(), 40U, first);
+        }
+        if (variant == 2) {
+            // Also exercise the validator's angular duplicate tolerance.
+            hole.insert(hole.begin() + 1, {southwest.latitude_degrees + 1.0e-9,
+                southwest.longitude_degrees + 1.0e-9});
+        }
+        auto enforcement = ExclusionZoneSet::create(
+            {{"duplicate-hole","synthetic",1,{},{},{repeated}}}, {"test","synthetic","1"});
+        REQUIRE(enforcement.has_value());
+        REQUIRE(!enforcement.value().contains(water_probe, TimePoint{}, ExclusionBoundaryPolicy::boundary_excluded));
+        REQUIRE(!enforcement.value().intersects_segment(from, TimePoint{}, to, TimePoint{} + 1h,
+            ExclusionBoundaryPolicy::boundary_excluded).violated);
+        auto options = topology_options();
+        options.maximum_work = 10'000'000U;
+        const std::array<Coordinate,1> water_probes{{water_probe}};
+        const auto duplicated = CoastalTopology::from_polygons({repeated}, water_probes, options);
+        REQUIRE(duplicated.has_value());
+        const double bound = duplicated.value()->optimistic_distance_nautical_miles(from,to,0.0);
+        std::cout << "DUPLICATE_HOLE_REGRESSION variant=" << variant
+                  << " bound_nm=" << bound << " legal_nm=" << legal_distance << '\n';
+        REQUIRE(bound <= legal_distance);
+        REQUIRE(duplicated.value()->cap_count() == 0U);
+        REQUIRE_NEAR(bound, reference->optimistic_distance_nautical_miles(from,to,0.0), 1.0e-8);
+        const std::array<Coordinate,2> mixed_probes{{water_probe,land_probe}};
+        const auto duplicated_land = CoastalTopology::from_polygons({repeated}, mixed_probes, options);
+        REQUIRE(duplicated_land.has_value());
+        REQUIRE(duplicated_land.value()->cap_count() == reference_land->cap_count());
+        REQUIRE_NEAR(duplicated_land.value()->optimistic_distance_nautical_miles(from,to,0.0),
+            reference_land->optimistic_distance_nautical_miles(from,to,0.0), 1.0e-8);
+    }
+}
