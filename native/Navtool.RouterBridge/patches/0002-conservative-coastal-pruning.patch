+ExclusionPolygon rectangle(double south, double west, double north, double east) {
+    return {{{{south, west}, {south, east}, {north, east}, {north, west}}}, {}};
+}
+CoastalTopologyOptions topology_options() {
+    CoastalTopologyOptions options;
+    options.source_identity = "test-polygon-v1";
+    options.domain_identity = "world-v1";
+    return options;
+}
+std::shared_ptr<const CoastalTopology> topology(std::vector<ExclusionPolygon> polygons,
+    std::vector<Coordinate> probes = {}) {
+    auto result = CoastalTopology::from_polygons(std::move(polygons), probes, topology_options());
+    REQUIRE(result.has_value());
+    return result.value();
+}
+void enable(RouteRequest& request, std::shared_ptr<const CoastalTopology> geometry) {
+    auto& options = request.options.coastal_pruning;
+    options.mode = CoastalPruningMode::conservative;
+    options.topology = std::move(geometry);
+    options.source_identity = options.topology->options().source_identity;
+    options.domain_identity = options.topology->options().domain_identity;
+}
+RouteRequest route_request(const WeatherDataset& weather) {
+    RouteRequest request;
+    request.start = {1.0, 0.4};
+    request.destination = {1.0, 1.3};
+    request.departure_time = weather.metadata().first_valid_time;
+    request.options.worker_count = 1U;
+    request.options.time_step = 30min;
+    request.options.use_routing_intervals = false;
+    request.options.maximum_route_duration = 12h;
+    request.options.heading_step_degrees = 15.0;
+    request.options.spatial_bucket_nautical_miles = 2.0;
+    request.options.max_nodes_per_bucket = 3U;
+    request.options.progress.payload = RoutingProgressPayload::retained_points | RoutingProgressPayload::destination_front;
+    request.options.progress.destination_front.mode = DestinationFrontMode::eligible_pre_prune;
+    return request;
+}
