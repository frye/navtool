+TEST_CASE("coastal seed preserves invalid environmental model errors") {
+    class AcceleratingModel final : public SeaStatePerformanceModel {
+        ProviderMetadata metadata_{"invalid","synthetic","1"};
+    public:
+        const ProviderMetadata& metadata() const noexcept override { return metadata_; }
+        double derated_speed_knots(const SeaStateInput& input) const override {
+            return input.flat_water_speed_knots + 100.0;
+        }
+    };
+    const test::ConstantWindGribFixture fixture;
+    const auto weather = WeatherDataset::load(fixture.path());
+    REQUIRE(weather.has_value());
+    RoutingEnvironment environment;
+    const auto waves = make_uniform_wave_provider({1,5,0}, {"waves","synthetic","1"});
+    REQUIRE(waves.has_value());
+    environment.waves.provider = waves.value();
+    environment.waves.model = std::make_shared<AcceleratingModel>();
+    auto request = route_request(weather.value());
+    request.options.segment_eligibility = [](const auto&) { return true; };
+    Router router{weather.value(), VesselPolar::default_racer_cruiser_45ft(), environment};
+    auto off = router.optimize(request);
+    REQUIRE(!off);
+    enable(request, topology({}));
+    auto on = router.optimize(request);
+    REQUIRE(!on);
+    REQUIRE(on.error().code == off.error().code);
+}
