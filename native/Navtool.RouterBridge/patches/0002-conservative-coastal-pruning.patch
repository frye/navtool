+        const UnitVector unit = to_unit_vector(vertex);
+        if (!vertices.empty() &&
+            angle_between(vertices.back(), unit) <= ring_boundary_tolerance_radians) {
+            continue;
+        }
+        vertices.push_back(unit);
+    }
+    while (vertices.size() > 1U &&
+           angle_between(vertices.front(), vertices.back()) <= ring_boundary_tolerance_radians) {
+        vertices.pop_back();
+    }
+    if (vertices.size() < 3U) {
+        return Error{ErrorCode::invalid_environment,
+            "exclusion ring must contain at least three distinct vertices"};
+    }
+    return vertices;
+}
