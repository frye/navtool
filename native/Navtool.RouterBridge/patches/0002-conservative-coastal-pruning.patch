+    const auto begin = std::chrono::steady_clock::now();
+    std::size_t off_northern_parents = 0U, on_northern_parents = 0U;
+    auto baseline = router.optimize_view(request, [&](const RoutingProgressView& view) {
+        for (const auto position : view.retained_points)
+            if (position.latitude_degrees > 1.15) ++off_northern_parents;
+    });
+    REQUIRE(baseline.has_value());
+    REQUIRE(baseline.value().completion == RouteCompletion::destination_reached);
+    const std::size_t off_northern = northern;
+    const auto middle = std::chrono::steady_clock::now();
+    northern = 0U;
+    // The six-mile cap is strictly inside the enforced peninsula, independent
+    // of polygon edge representation. This exercises the default-source ABI
+    // handoff in which the application supplies its own certified land subset.
+    auto cap_options = topology_options();
+    cap_options.polygon_edges = CoastalPolygonEdges::linear_latitude_longitude;
+    auto caps = CoastalTopology::from_certified_caps({{{1.45,0.9},6.0}}, cap_options);
+    REQUIRE(caps.has_value());
+    enable(request, caps.value());
+    CoastalPruningDiagnostics previous;
+    bool retained_progress = false;
+    auto pruned = router.optimize_view(request, [&](const RoutingProgressView& view) {
+        REQUIRE(view.diagnostics.coastal_pruning.has_value());
+        const auto& audit = *view.diagnostics.coastal_pruning;
+        REQUIRE(audit.candidates_incumbent >= previous.candidates_incumbent);
+        REQUIRE(audit.seed_transition_evaluations >= previous.seed_transition_evaluations);
+        previous = audit;
+        if (!view.retained_points.empty()) {
+            REQUIRE(view.post_proof_retained_front);
+            retained_progress = true;
+            for (const auto position : view.retained_points)
+                if (position.latitude_degrees > 1.15) ++on_northern_parents;
+            for (const auto& segment : view.destination_front.segments)
+                REQUIRE(segment.point_offset + segment.point_count <= view.destination_front.points.size());
+        }
+    });
+    REQUIRE(pruned.has_value());
+    REQUIRE(pruned.value().completion == RouteCompletion::destination_reached);
+    REQUIRE(pruned.value().arrival_time <= baseline.value().arrival_time + 2s);
+    const auto& audit = *pruned.value().diagnostics.coastal_pruning;
+    REQUIRE(audit.seed_status == "validated");
+    REQUIRE(audit.polygon_edge_model == "caller_certified_caps");
+    REQUIRE(audit.incumbent_arrival.has_value());
+    REQUIRE(audit.candidates_incumbent + audit.candidates_horizon > 0U);
+    REQUIRE(pruned.value().diagnostics.expanded_nodes < baseline.value().diagnostics.expanded_nodes);
+    REQUIRE(retained_progress);
+    std::cout << "COASTAL_BENCHMARK off_expanded=" << baseline.value().diagnostics.expanded_nodes
+        << " on_expanded=" << pruned.value().diagnostics.expanded_nodes
+        << " off_northern_segments=" << off_northern << " on_northern_segments=" << northern
+        << " off_northern_parents=" << off_northern_parents << " on_northern_parents=" << on_northern_parents
+        << " seed_transitions=" << audit.seed_transition_evaluations
+        << " prep_work=" << audit.topology_work
+        << " off_ms=" << std::chrono::duration_cast<std::chrono::milliseconds>(middle-begin).count()
+        << " on_ms=" << std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now()-middle).count() << '\n';
+    REQUIRE(northern * 2U <= off_northern);
+    REQUIRE(on_northern_parents * 2U <= off_northern_parents);
+    const auto json = route_to_json(pruned.value());
+    REQUIRE(json.has_value());
+    REQUIRE(json.value().find("\"coastalPruning\"") != std::string::npos);
+    REQUIRE(json.value().find("\"seedStatus\":\"validated\"") != std::string::npos);
+    auto replay_request = request;
+    replay_request.options.coastal_pruning.mode = CoastalPruningMode::off;
+    const auto replay = router.evaluate_actions(replay_request, pruned.value().coastal_seed_actions);
+    REQUIRE(replay.has_value());
+    REQUIRE(replay.value().arrival_time >= pruned.value().arrival_time);
+    for (const auto& point : replay.value().points) {
+        auto bound = router.coastal_remaining_bound(request, point.position);
+        REQUIRE(bound.has_value());
+        REQUIRE(bound.value().status == CoastalBoundStatus::available);
+        REQUIRE(bound.value().optimistic_seconds <=
+            std::chrono::duration<double>(replay.value().arrival_time - point.time).count() + 2.0);
+    }
+    request.options.worker_count = 2U;
+    const auto parallel = router.optimize(request);
+    REQUIRE(parallel.has_value());
+    REQUIRE(parallel.value().arrival_time == pruned.value().arrival_time);
+    REQUIRE(parallel.value().diagnostics.expanded_nodes == pruned.value().diagnostics.expanded_nodes);
+    REQUIRE(parallel.value().diagnostics.coastal_pruning->candidates_incumbent == audit.candidates_incumbent);
+}
+
