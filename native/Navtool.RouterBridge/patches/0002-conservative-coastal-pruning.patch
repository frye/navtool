+Result<std::vector<UnitVector>> normalize_ring_vertices(
+    std::span<const Coordinate> input) {
+    std::vector<UnitVector> vertices;
+    vertices.reserve(input.size());
+    for (const Coordinate vertex : input) {
+        if (!is_valid(vertex)) {
