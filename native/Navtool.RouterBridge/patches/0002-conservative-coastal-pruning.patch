+TEST_CASE("coastal horizon proof preserves legal partial and opening exclusions are relaxed") {
+    const test::ConstantWindGribFixture fixture;
+    const auto weather = WeatherDataset::load(fixture.path());
+    REQUIRE(weather.has_value());
+    auto request = route_request(weather.value());
+    request.options.segment_eligibility = [](const auto&) { return true; };
+    enable(request, topology({}));
+    request.options.maximum_route_duration = 1h;
+    request.options.coastal_pruning.maximum_seed_transitions = 0U;
+    Router router{weather.value()};
+    auto partial = router.optimize(request);
+    REQUIRE(partial.has_value());
+    REQUIRE(partial.value().completion == RouteCompletion::duration_exhausted);
+    REQUIRE(partial.value().points.front().position.longitude_degrees == request.start.longitude_degrees);
+    REQUIRE(!partial.value().diagnostics.coastal_pruning->incumbent_arrival);
+    REQUIRE(partial.value().diagnostics.coastal_pruning->parent_expansions_skipped == 1U);
+    request.options.maximum_route_duration = 48h;
+    request.destination = {1.0,2.0};
+    partial = router.optimize(request);
+    REQUIRE(partial.has_value());
+    REQUIRE(partial.value().completion == RouteCompletion::destination_reached ||
+        partial.value().completion == RouteCompletion::forecast_exhausted);
+    request = route_request(weather.value());
+    request.options.segment_eligibility = [](const auto&) { return true; };
+    enable(request, topology({}));
+    RoutingEnvironment environment;
+    auto opening = ExclusionZoneSet::create({{"opening","test",1,{},*request.departure_time + 10min,
+        {rectangle(0.8,0.55,1.2,0.65)}}}, {"test","test","1"});
+    REQUIRE(opening.has_value());
+    environment.exclusions.zones = opening.value();
+    Router timed{weather.value(), VesselPolar::default_racer_cruiser_45ft(), environment};
+    const auto result = timed.optimize(request);
+    REQUIRE(result.has_value());
+    REQUIRE(result.value().completion == RouteCompletion::destination_reached);
+    REQUIRE(result.value().diagnostics.coastal_pruning->seed_status == "validated");
+}
