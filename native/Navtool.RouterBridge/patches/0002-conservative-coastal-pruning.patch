+TEST_CASE("coastal caps are optimistic against independently constructed legal sphere paths") {
+    auto mask = topology({rectangle(-0.2, -0.2, 0.2, 0.2)}, {{0,0}});
+    REQUIRE(mask->cap_count() == 1U);
+    const Coordinate start{0,-0.5}, end{0,0.5};
+    const double direct = detail::great_circle_distance_nautical_miles(start, end);
+    const double bound = mask->optimistic_distance_nautical_miles(start, end, 0.0);
+    REQUIRE(bound > direct + 1.0);
+    // Enumerate many legal detours around the whole square, not just its cap.
+    for (double latitude : {-0.3, -0.4, -0.8, 0.3, 0.4, 0.8}) {
+        const Coordinate left{latitude,-0.3}, right{latitude,0.3};
+        const double feasible = detail::great_circle_distance_nautical_miles(start,left) +
+            detail::great_circle_distance_nautical_miles(left,right) +
+            detail::great_circle_distance_nautical_miles(right,end);
+        REQUIRE(bound <= feasible);
+        for (double arrival : {0.1, 1.0, 5.0, 20.0, 100.0}) {
+            const double h = mask->optimistic_distance_nautical_miles(start, end, arrival);
+            REQUIRE(h >= 0.0);
+            REQUIRE(h <= feasible);
+            REQUIRE(h <= bound + 1e-6);
+        }
+    }
+    REQUIRE(mask->optimistic_distance_nautical_miles(end,end,0.1) == 0.0);
+}
