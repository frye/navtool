<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Navtool.App.ViewModels"
        xmlns:views="using:Navtool.App.Views"
        xmlns:core="using:Navtool.Core"
        xmlns:mapsui="using:Mapsui.UI.Avalonia"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        x:Class="Navtool.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Width="1280"
        Height="800"
        MinWidth="1040"
        MinHeight="680"
        Background="{DynamicResource WindowBackgroundColor}"
        Icon="/Assets/avalonia-logo.ico"
        Title="Navtool · Weather Routing">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.interrupted-endpoint">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningTextColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid x:Name="ShellGrid" RowDefinitions="Auto,*,Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" MinWidth="320" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="560" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" Padding="12,8"
                Background="{DynamicResource SidebarBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="NAVTOOL" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ToggleButton x:Name="PlanningDrawerHandle" Content="Plan" Click="OnPlanningDrawerClicked"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Plan panel" ToolTip.Tip="Plan a passage (Ctrl+1)" />
                    <ToggleButton x:Name="RouteDrawerHandle" Content="Results" Click="OnRouteDrawerClicked"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Results panel" ToolTip.Tip="Results and passage progress (Ctrl+2)" />
                    <ToggleButton x:Name="SettingsTabButton" Content="Settings" Click="OnSettingsClicked"
                                  AutomationProperties.Name="Settings panel" ToolTip.Tip="Routing settings (Ctrl+3)" />
                    <Button x:Name="CollapsePanelButton" Content="Collapse" Click="OnCollapsePanelClicked"
                            AutomationProperties.Name="Collapse working panel" ToolTip.Tip="Show or hide working panel (Ctrl+Backslash)" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Itinerary.RouteName}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Routes" AutomationProperties.Name="Route library and saving">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="340" Spacing="8">
                                <TextBlock Text="Route name" Classes="field-label" />
                                <TextBox Text="{Binding Itinerary.RouteName}" Watermark="Route name" />
                                <TextBlock Text="Saved routes" Classes="field-label" />
                                <Grid x:Name="SavedRouteActions" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <ComboBox ItemsSource="{Binding Itinerary.SavedPlans}" SelectedItem="{Binding Itinerary.SelectedSavedPlan}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:RoutePlanSummary"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="New" Command="{Binding Itinerary.NewCommand}" />
                                    <Button Grid.Column="2" Content="Open" Command="{Binding Itinerary.OpenCommand}" />
                                </Grid>
                                <Button Content="Refresh library" Command="{Binding Itinerary.RefreshSavedPlansCommand}" />
                                <Grid x:Name="SaveRouteActions" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding Itinerary.SaveAsName}" Watermark="Save-as name" />
                                    <Button Grid.Column="1" Content="Save as" Command="{Binding Itinerary.SaveAsCommand}" />
                                    <Button Grid.Column="2" Content="Save" Command="{Binding Itinerary.SaveCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding Itinerary.IsDirty, StringFormat=Unsaved changes: {0}}" Classes="muted" />
                                <TextBlock Text="{Binding Itinerary.StorageError}" Classes="error" TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
        <GridSplitter x:Name="WorkingPanelSplitter" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch" Background="{DynamicResource BorderColor}"
                      AutomationProperties.Name="Resize working panel" />
        <Grid x:Name="PlanningDrawer"
              Grid.Column="0" Grid.Row="1"
              Background="{DynamicResource SidebarBackgroundColor}">
            <Border x:Name="PlanningDrawerContent"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,1,0"
                    IsVisible="True">
                <ScrollViewer x:Name="PlanningScrollViewer" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" Spacing="10">
                        <Border x:Name="EndpointsPanel" Classes="card" Padding="8">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title"
                                          Text="PLAN A PASSAGE" />
                                <Grid x:Name="EndpointActions"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="8">
                                    <ToggleButton x:Name="SetStartButton"
                                                 Classes="map-tool"
                                                  Content="Set start"
                                                  IsChecked="{Binding IsSettingStart, Mode=OneWay}"
                                                  Command="{Binding SetStartCommand}"
                                                  ToolTip.Tip="Arm start placement, then select the map" />
                                    <ToggleButton x:Name="SetDestinationButton"
                                                  Grid.Column="1"
                                                  Classes="map-tool"
                                                  Content="Set finish"
                                                  IsChecked="{Binding IsSettingDestination, Mode=OneWay}"
                                                  Command="{Binding SetDestinationCommand}"
                                                  ToolTip.Tip="Arm finish placement, then select the map" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <TextBlock Text="{Binding StartDisplay}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding DestinationDisplay}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Expander x:Name="WaypointEditorExpander" Header="Waypoints &amp; stopovers" IsExpanded="False">
                                <StackPanel Spacing="6">
                                <ListBox x:Name="WaypointList"
                                         Classes="waypoint-list"
                                         ItemsSource="{Binding Itinerary.Waypoints}"
                                         SelectedItem="{Binding Itinerary.SelectedWaypoint, Mode=TwoWay}"
                                         SelectionMode="Single">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WaypointEditorItemViewModel">
                                            <Border Classes="subtle waypoint-editor"
                                                    Margin="0,0,0,6"
                                                    AutomationProperties.Name="{Binding AccessibleName}">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
                                                        <Border Width="24"
                                                                Height="24"
                                                                CornerRadius="12"
                                                                Background="{DynamicResource AccentColor}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PositionLabel}"
                                                                       Foreground="{DynamicResource AccentTextColor}"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="2">
                                                            <TextBox Text="{Binding Name}" />
                                                            <TextBlock Text="{Binding CoordinateDisplay}"
                                                                       Classes="muted" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Content="Map"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding SetOnMapCommand}" />
                                                    </Grid>
                                                    <Grid IsVisible="{Binding IsIntermediate}"
                                                          ColumnDefinitions="Auto,*"
                                                          RowDefinitions="Auto,Auto"
                                                          ColumnSpacing="8"
                                                          RowSpacing="4">
                                                        <CheckBox Content="Stopover"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding HasStopover}" />
                                                        <Grid Grid.Column="1"
                                                              ColumnDefinitions="*,Auto"
                                                              ColumnSpacing="4">
                                                            <NumericUpDown MinWidth="88"
                                                                           Minimum="0.25"
                                                                           Maximum="240"
                                                                           Increment="0.25"
                                                                           Value="{Binding StopoverHours}"
                                                                           IsEnabled="{Binding HasStopover}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Classes="field-label"
                                                                       Text="hours"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                        <StackPanel Grid.Row="1"
                                                                    Grid.ColumnSpan="2"
                                                                    Classes="compact-action-row"
                                                                    HorizontalAlignment="Right">
                                                            <Button Classes="compact-action"
                                                                    Content="↑"
                                                                    ToolTip.Tip="Move waypoint earlier"
                                                                    Command="{Binding MoveUpCommand}" />
                                                            <Button Classes="compact-action"
                                                                    Content="↓"
                                                                    ToolTip.Tip="Move waypoint later"
                                                                    Command="{Binding MoveDownCommand}" />
                                                            <Button Classes="compact-action"
                                                                    Content="×"
                                                                    ToolTip.Tip="Remove waypoint"
                                                                    Command="{Binding RemoveCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Add waypoint"
                                        Command="{Binding Itinerary.AddWaypointCommand}" />
                                </StackPanel>
                                </Expander>
                                <TextBlock Text="{Binding Itinerary.ValidationMessage}"
                                           Classes="error"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DeparturePanel" Classes="card" Padding="8">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Departure" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <CheckBox x:Name="DepartureNowToggle" Grid.Column="1" Content="Now" IsChecked="{Binding DepartureNow}" />
                                </Grid>
                                <StackPanel IsVisible="{Binding !DepartureNow}" Spacing="4">
                                    <Grid x:Name="DepartureFields" ColumnDefinitions="*,104" ColumnSpacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="field-label" Text="Departure date (local)" />
                                            <DatePicker x:Name="DepartureDatePicker" SelectedDate="{Binding DepartureDate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="field-label" Text="Time (local)" />
                                            <TimePicker x:Name="DepartureTimePicker" SelectedTime="{Binding DepartureTime}" ClockIdentifier="24HourClock" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="DepartureUtcPreviewText" Classes="muted" Text="{Binding DepartureUtcPreview}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Forecast horizon: {0}d {1}h">
                                                    <Binding Path="PassageDays" />
                                                    <Binding Path="PassageHours" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Expander.Header>
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Forecast days" Classes="field-label" />
                                                <NumericUpDown x:Name="PassageDaysInput" Minimum="0" Maximum="10" Increment="1" FormatString="0" Value="{Binding PassageDays}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Additional hours" Classes="field-label" />
                                                <NumericUpDown x:Name="PassageHoursInput" Minimum="0" Maximum="23" Increment="1" FormatString="0" Value="{Binding PassageHours}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Classes="muted" Text="Weather acquisition horizon, not a promised arrival or engine search limit. Maximum 10 days." TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding UtcOffsetDisplay, StringFormat=Current UTC offset: {0}}" Classes="muted" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ForecastModelsPanel" Classes="card" Padding="8">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Forecast models" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Options" Click="OnForecastOptionsClicked" />
                                </Grid>
                                <WrapPanel IsVisible="{Binding IsDownloadForecast}">
                                    <CheckBox x:Name="NoaaModelToggle" Content="NOAA GFS" IsChecked="{Binding UseNoaa}" Margin="0,0,16,0" />
                                    <CheckBox x:Name="EcmwfModelToggle" Content="ECMWF IFS" IsChecked="{Binding UseEcmwf}" />
                                </WrapPanel>
                                <TextBlock IsVisible="{Binding IsLocalForecast}" Text="{Binding LocalGribPath, TargetNullValue=Choose a GRIB file in Options}"
                                           ToolTip.Tip="{Binding LocalGribPath}" Classes="muted" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="BoatSummaryPanel" Classes="card" Padding="8">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding RoutingSetup.BoatSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding RoutingSetup.BoatSummary}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Change" Click="OnBoatChangeClicked" />
                                </Grid>
                                <TextBlock Classes="muted">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} routing · {1}% boat performance">
                                            <Binding Path="RoutingSetup.Quality" Converter="{x:Static views:RoutingOptionLabelConverter.Instance}" />
                                            <Binding Path="RoutingSetup.PerformancePercentage" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock IsVisible="{Binding EnableProfessionalRouting}" Text="Expert overrides active" Foreground="{DynamicResource WarningTextColor}" />
                                <TextBlock IsVisible="{Binding RoutingSetup.EnableCoastalPruning}" Text="Experimental coastal pruning active" Foreground="{DynamicResource WarningTextColor}" />
                                <TextBlock IsVisible="{Binding RoutingSetup.IsDemoBoat}" Text="DEMO BOAT - illustrative, not your vessel." TextWrapping="Wrap" Foreground="{DynamicResource WarningTextColor}" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="SettingsContent" Spacing="10" IsVisible="False">
                        <Button Content="Back to passage" Click="OnSettingsBackClicked" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding PreferenceStatus}" TextWrapping="Wrap" Classes="muted"
                                   IsVisible="{Binding PreferenceStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <Expander x:Name="ForecastSettingsExpander" Header="Forecasts &amp; data">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Select forecast models in Plan." Classes="muted" />
                                <RadioButton x:Name="DownloadForecastSource" GroupName="ForecastSource" Content="Download forecast"
                                             IsChecked="{Binding IsDownloadForecast, Mode=OneWay}" Command="{Binding SelectDownloadSourceCommand}" />
                                <RadioButton x:Name="LocalForecastSource" GroupName="ForecastSource" Content="Existing GRIB file"
                                             IsChecked="{Binding IsLocalForecast, Mode=OneWay}" Command="{Binding SelectLocalFileSourceCommand}" />
                                <StackPanel IsVisible="{Binding IsDownloadForecast}" Spacing="6">
                                    <TextBlock Text="Forecast freshness" Classes="field-label" />
                                    <ComboBox ItemsSource="{Binding RoutingSetup.ForecastPolicyOptions}" SelectedItem="{Binding RoutingSetup.ForecastPolicy}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:ForecastRefreshPolicy">
                                                <TextBlock Text="{Binding ., Converter={x:Static views:RoutingOptionLabelConverter.Instance}}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Reuse a covering cached run, or require the newest published run." Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding NoaaStatus}" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding EcmwfStatus}" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsLocalForecast}" Spacing="6">
                                    <Button x:Name="ChooseGribFileButton" Click="OnChooseGribFileClicked" IsEnabled="{Binding !IsInspectingLocalGrib}" Content="Choose GRIB file..." />
                                    <TextBlock Text="{Binding LocalGribDisplay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LocalGribPath}" Classes="muted" TextWrapping="Wrap"
                                               IsVisible="{Binding LocalGribPath, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding LocalGribStatus}" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="Maximum interpolation gap (hours)" Classes="field-label" TextWrapping="Wrap" />
                                    <NumericUpDown Value="{Binding RoutingSetup.LocalForecastMaximumGapHours}" Minimum="0.1" Maximum="24" Increment="1" />
                                </StackPanel>
                                <TextBlock Text="{Binding ForecastAreaSummary}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <views:RoutingSetupView x:Name="CruisingSetupPanel" />
                        <Expander x:Name="AdvancedSettingsExpander" Header="Advanced &amp; experimental">
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title"
                                           Text="EXPERT OVERRIDES" />
                                <TextBlock Text="{Binding LiveSearchStatus}" Classes="muted" TextWrapping="Wrap" />
                                <CheckBox x:Name="ProfessionalRoutingToggle"
                                          Content="Enable expert overrides"
                                          IsChecked="{Binding EnableProfessionalRouting}"
                                          IsEnabled="{Binding !IsCalculating}" />
                                <TextBlock Classes="muted"
                                           Text="Values are remembered, but inactive until explicitly enabled. Off uses your native quality preset, PCHIP and NoSpeed above the polar range."
                                           TextWrapping="Wrap" />
                                <CheckBox x:Name="CoastalPruningToggle" Content="Experimental conservative coastal pruning" IsChecked="{Binding RoutingSetup.EnableCoastalPruning}" />
                                <TextBlock Text="Experimental pruning is separately opt-in. It does not certify chart safety or global optimality." Classes="muted" TextWrapping="Wrap" />
                                <CheckBox Content="Override hard search duration (hours)" IsChecked="{Binding RoutingSetup.UseHardDuration}" />
                                <NumericUpDown Value="{Binding RoutingSetup.HardDurationHours}" IsVisible="{Binding RoutingSetup.UseHardDuration}" Minimum="1" Maximum="240" Increment="1" />
                                <StackPanel IsVisible="{Binding EnableProfessionalRouting}"
                                            IsEnabled="{Binding !IsCalculating}"
                                            Spacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-label" Text="Solver" />
                                        <ComboBox x:Name="RouteSolverSelector"
                                                  ItemsSource="{Binding RouteSolverOptions}"
                                                  SelectedItem="{Binding SelectedRouteSolver}" />
                                        <TextBlock Classes="muted"
                                                  Text="The lattice solver is opt-in; standard routing always remains on the isochrone beam."
                                                  TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="Boat handling" Classes="section-title" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="field-label" Text="Tack penalty (s)" />
                                            <NumericUpDown Minimum="0" Maximum="3600"
                                                           Value="{Binding TackPenaltySeconds}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="field-label" Text="Gybe penalty (s)" />
                                            <NumericUpDown Minimum="0" Maximum="3600"
                                                           Value="{Binding GybePenaltySeconds}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-label" Text="Downwind threshold (° TWA)" />
                                        <NumericUpDown Minimum="0" Maximum="180" Increment="1"
                                                       Value="{Binding DownwindTrueWindAngleDegrees}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-label" Text="Heading augmentation" />
                                        <ComboBox ItemsSource="{Binding HeadingAugmentationOptions}"
                                                  SelectedItem="{Binding HeadingAugmentation}" />
                                    </StackPanel>
                                    <TextBlock Text="Wind &amp; polar behavior" Classes="section-title" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="field-label" Text="Wind sampling" />
                                            <ComboBox ItemsSource="{Binding WindSamplingOptions}"
                                                      SelectedItem="{Binding WindSampling}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="field-label" Text="Midpoint threshold (min)" />
                                            <NumericUpDown Minimum="0" Maximum="1440"
                                                           Value="{Binding MidpointWindSamplingThresholdMinutes}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-label" Text="Polar interpolation" />
                                        <ComboBox ItemsSource="{Binding PolarInterpolationOptions}"
                                                  SelectedItem="{Binding PolarAngleInterpolation}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <CheckBox Content="Maximum wind (kt)"
                                                  IsChecked="{Binding UseMaximumTrueWindSpeed}" />
                                        <NumericUpDown Grid.Column="1" Minimum="1" Maximum="200"
                                                       IsEnabled="{Binding UseMaximumTrueWindSpeed}"
                                                       Value="{Binding MaximumTrueWindSpeedKnots}" />
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-label" Text="Above polar range" />
                                        <ComboBox ItemsSource="{Binding AbovePolarRangeOptions}"
                                                  SelectedItem="{Binding AbovePolarRange}" />
                                    </StackPanel>
                                    <TextBlock Text="Search mechanics" Classes="section-title" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="field-label" Text="Pruning" />
                                            <ComboBox ItemsSource="{Binding PruningStrategyOptions}"
                                                      SelectedItem="{Binding PruningStrategy}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="field-label" Text="Sector width (°)" />
                                            <NumericUpDown Minimum="0.1" Maximum="180" Increment="0.5"
                                                           Value="{Binding PruningSectorDegrees}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="BeamRoutingOptions"
                                                IsVisible="{Binding IsProfessionalBeamRouting}"
                                                Spacing="8">
                                        <TextBlock Classes="field-label" Text="Destination front" />
                                        <ComboBox ItemsSource="{Binding DestinationFrontPolicyOptions}"
                                                  SelectedItem="{Binding DestinationFrontSegmentPolicy}" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="Front half-angle (degrees)" Classes="field-label" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="Minimum secondary points" Classes="field-label" TextWrapping="Wrap" />
                                            <NumericUpDown Grid.Row="1" Minimum="1" Maximum="180"
                                                           AutomationProperties.Name="Destination front half-angle in degrees"
                                                           Value="{Binding DestinationFrontHalfAngleDegrees}" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000"
                                                           AutomationProperties.Name="Minimum secondary segment points"
                                                           Value="{Binding DestinationFrontMinimumSecondarySegmentPoints}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel x:Name="LatticeRoutingOptions"
                                                IsVisible="{Binding IsProfessionalLatticeRouting}"
                                                Spacing="8">
                                        <TextBlock Classes="field-label" Text="Lattice search" />
                                        <ComboBox ItemsSource="{Binding LatticeSearchAlgorithmOptions}"
                                                  SelectedItem="{Binding LatticeSearchAlgorithm}" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="Subdivision level" Classes="field-label" />
                                            <TextBlock Grid.Column="1" Text="Refinement levels" Classes="field-label" />
                                            <NumericUpDown Grid.Row="1" Minimum="0" Maximum="8" AutomationProperties.Name="Lattice subdivision level"
                                                           Value="{Binding LatticeSubdivisionLevel}" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="8" AutomationProperties.Name="Lattice refinement levels"
                                                           Value="{Binding LatticeRefinementLevels}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="Time bucket (min)" Classes="field-label" />
                                            <TextBlock Grid.Column="1" Text="Corridor width (NM)" Classes="field-label" />
                                            <NumericUpDown Grid.Row="1" Minimum="1" Maximum="1440" AutomationProperties.Name="Lattice time bucket in minutes"
                                                           Value="{Binding LatticeTimeBucketMinutes}" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="5000" AutomationProperties.Name="Lattice corridor width in nautical miles"
                                                           Value="{Binding LatticeCorridorWidthNauticalMiles}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="Widening retries" Classes="field-label" />
                                            <TextBlock Grid.Column="1" Text="Progress interval (expansions)" Classes="field-label" TextWrapping="Wrap" />
                                            <NumericUpDown Grid.Row="1" Minimum="0" Maximum="20" AutomationProperties.Name="Lattice corridor widening retries"
                                                           Value="{Binding LatticeCorridorWideningRetries}" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000000" AutomationProperties.Name="Lattice progress interval in expansions"
                                                           Value="{Binding LatticeProgressEveryExpansions}" />
                                        </Grid>
                                    </StackPanel>
                                    <Separator />
                                    <StackPanel x:Name="EnvironmentalPhysicsOptions" Spacing="8">
                                        <TextBlock Classes="field-label" Text="Environmental physics" />
                                        <TextBlock Classes="muted"
                                                   Text="Each provider below is individually opt-in. With all of them off the route is calculated exactly as it is outside professional routing."
                                                   TextWrapping="Wrap" />
                                        <CheckBox x:Name="CurrentFieldToggle"
                                                  Content="Uniform current"
                                                  IsChecked="{Binding EnableCurrentField}" />
                                        <StackPanel IsVisible="{Binding EnableCurrentField}" Spacing="4">
                                            <TextBlock Classes="muted"
                                                       Text="Oceanographic set: the direction the water flows toward, which is the opposite of the wind convention."
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="field-label" Text="East (kt)" />
                                                    <NumericUpDown Minimum="-20" Maximum="20" Increment="0.1"
                                                                   Value="{Binding CurrentEastKnots}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Classes="field-label" Text="North (kt)" />
                                                    <NumericUpDown Minimum="-20" Maximum="20" Increment="0.1"
                                                                   Value="{Binding CurrentNorthKnots}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Classes="field-label" Text="Outside coverage" />
                                            <ComboBox ItemsSource="{Binding MissingDataPolicyOptions}"
                                                      SelectedItem="{Binding CurrentMissingDataPolicy}" />
                                        </StackPanel>
                                        <CheckBox x:Name="SeaStateToggle"
                                                  Content="Sea state derating"
                                                  IsChecked="{Binding EnableSeaState}" />
                                        <StackPanel IsVisible="{Binding EnableSeaState}" Spacing="4">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="field-label" Text="Height (m)" />
                                                    <NumericUpDown Minimum="0" Maximum="30" Increment="0.1"
                                                                   Value="{Binding SignificantWaveHeightMetres}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Classes="field-label" Text="Period (s)" />
                                                    <NumericUpDown Minimum="0.1" Maximum="30" Increment="0.5"
                                                                   Value="{Binding WavePeriodSeconds}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Classes="field-label" Text="From direction (° true)" />
                                            <NumericUpDown Minimum="0" Maximum="360" Increment="5"
                                                           Value="{Binding WaveFromDirectionDegrees}" />
                                            <TextBlock Classes="field-label" Text="Outside coverage" />
                                            <ComboBox ItemsSource="{Binding MissingDataPolicyOptions}"
                                                      SelectedItem="{Binding WaveMissingDataPolicy}" />
                                        </StackPanel>
                                        <CheckBox x:Name="AntarcticExclusionToggle"
                                                  Content="Antarctic exclusion zone (example)"
                                                  IsChecked="{Binding EnableAntarcticExclusionZone}" />
                                        <StackPanel IsVisible="{Binding EnableAntarcticExclusionZone}"
                                                    Spacing="4">
                                            <TextBlock Classes="muted"
                                                       Text="An illustrative 62°S ice limit bundled with Navtool. Replace it with the notice of race before using it to plan a real passage."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Classes="field-label" Text="Boundary" />
                                            <ComboBox ItemsSource="{Binding ExclusionBoundaryPolicyOptions}"
                                                      SelectedItem="{Binding ExclusionBoundaryPolicy}" />
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding IsEnvironmentConfigured}" Spacing="4">
                                            <TextBlock Classes="field-label" Text="Sampling" />
                                            <ComboBox ItemsSource="{Binding EnvironmentSamplingOptions}"
                                                      SelectedItem="{Binding EnvironmentSampling}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        </Expander>
                        <Expander Header="Appearance">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Color scheme" Classes="field-label" />
                            <ComboBox x:Name="ThemeSelector"
                                      Classes="theme-picker" />
                        </StackPanel>
                        </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border x:Name="CalculationFooter" Grid.Row="2" Grid.Column="0" Padding="12,8"
                Background="{DynamicResource SidebarBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="5">
                <TextBlock x:Name="CalculationReadinessText" Text="{Binding CalculationReadiness}" Classes="muted" TextWrapping="Wrap"
                           AutomationProperties.Name="Calculation readiness" />
                <TextBlock IsVisible="{Binding IsCalculating}" Text="{Binding CalculationProgressDisplay}" Classes="muted" TextWrapping="Wrap" />
                <ProgressBar IsVisible="{Binding IsCalculating}" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="5" />
                <Button x:Name="FooterMessagesButton" Content="Messages" IsVisible="False"
                        Click="OnMessagesClicked" AutomationProperties.Name="Review routing messages" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button x:Name="CalculateRoutesButton" Classes="primary" Command="{Binding CalculateCommand}" Content="Calculate route" />
                    <Button x:Name="CancelButton" Grid.Column="1" Command="{Binding CancelCommand}" Content="Cancel" IsVisible="{Binding IsCalculating}" />
                </Grid>
                <TextBlock Text="Planning aid only. Independently verify the route." FontSize="11" Foreground="{DynamicResource WarningTextColor}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Column="2" Grid.Row="1" Grid.RowSpan="2"
              x:Name="MapShell"
              MinWidth="560"
              Background="{DynamicResource WindowBackgroundColor}">
            <mapsui:MapControl x:Name="MapView"
                               Map="{Binding Map}"
                               Focusable="True"
                               UseContinuousMouseWheelZoom="True"
                               AutomationProperties.Name="Route planning map" />

            <Button Content="Fit selected leg" Command="{Binding FocusSelectedLegCommand}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                    ToolTip.Tip="Fit the selected leg while retaining full-route context" />

            <Grid x:Name="InstrumentRailHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="16"
                  MaxWidth="540">
                <Border x:Name="InstrumentRail"
                        Classes="map-overlay"
                        CornerRadius="18"
                        Padding="0"
                        ClipToBounds="True"
                        IsHitTestVisible="False">
                    <Grid>
                    <StackPanel x:Name="InstrumentRailProgressRow"
                                Margin="14,7,14,10"
                                Orientation="Horizontal"
                                Spacing="11"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsCalculating}">
                        <TextBlock Text="{Binding CalculationRouteTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   MaxWidth="150"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Border Width="1"
                                Background="{DynamicResource OverlayBorderColor}" />
                        <TextBlock Text="{Binding CalculationStageLabel}"
                                   Classes="muted"
                                   FontSize="11"
                                   MaxWidth="240"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Border Width="1"
                                Background="{DynamicResource OverlayBorderColor}" />
                        <TextBlock Text="{Binding CalculationModelLabel}"
                                   Classes="muted"
                                   FontSize="11"
                                   MaxWidth="105"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProgressFraction, StringFormat={}{0:P0}}"
                                   Foreground="{DynamicResource AccentColor}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Border Width="58"
                                Height="26" />
                    </StackPanel>

                    <ProgressBar x:Name="InstrumentRailProgressBar"
                                 Classes="instrument-progress"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding ProgressFraction}"
                                 VerticalAlignment="Bottom"
                                 IsVisible="{Binding IsCalculating}"
                                 AutomationProperties.Name="Route calculation progress"
                                 AutomationProperties.HelpText="{Binding CalculationStageLabel}" />
                    </Grid>
                </Border>
                <Button x:Name="InstrumentRailCancelButton"
                        Classes="instrument-cancel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,7,14,0"
                        IsVisible="{Binding IsCalculating}"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        AutomationProperties.Name="Cancel route calculation" />
            </Grid>

            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,68,16,0" Spacing="6">
            <Border x:Name="MapInstructionOverlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Classes="map-overlay"
                    CornerRadius="14"
                    Padding="12,7"
                    IsVisible="{Binding IsEndpointPlacementArmed}"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding MapInstruction}"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Border>
            </StackPanel>

            <Canvas x:Name="InterruptedEndpointLayer" ZIndex="10" />
            <Button x:Name="MessagesButton" ZIndex="11" Content="Messages" IsVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                    Click="OnMessagesClicked" AutomationProperties.Name="Review routing messages"
                    AutomationProperties.LiveSetting="Polite" />
            <Border x:Name="MessagePopup" ZIndex="11" IsVisible="False"
                    SizeChanged="OnMessagePopupSizeChanged"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,68,16,16"
                    Width="400" MaxHeight="420" Padding="16" CornerRadius="10"
                    Background="{DynamicResource SidebarBackgroundColor}"
                    BorderBrush="{DynamicResource WarningTextColor}" BorderThickness="2"
                    BoxShadow="0 8 30 0 #60000000"
                    AutomationProperties.Name="Routing messages">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock x:Name="MessagePopupTitle" Text="Messages" FontSize="19"
                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="CloseMessagesButton" Grid.Column="1" Content="Close"
                                Click="OnCloseMessagesClicked" AutomationProperties.Name="Close messages" />
                    </Grid>
                    <ScrollViewer x:Name="MessageScrollViewer" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="MessageIncompleteText" IsVisible="False" TextWrapping="Wrap"
                                       Text="Incomplete: the dashed paths are not completed routes. Recalculate to try again."
                                       Foreground="{DynamicResource WarningTextColor}" />
                            <StackPanel x:Name="MessageItems" Spacing="12" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="ChartTimeline" Classes="map-overlay" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="16,0,16,24">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static conv:BoolConverters.Or}">
                        <Binding Path="HasTimeline" />
                        <Binding Path="HasNoaaWeather" />
                        <Binding Path="HasEcmwfWeather" />
                    </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <WrapPanel>
                            <RadioButton Content="NOAA GFS" GroupName="RouteModel" Command="{Binding ActivateNoaaRouteCommand}"
                                         IsChecked="{Binding IsNoaaRouteActive, Mode=OneWay}" IsVisible="{Binding HasNoaaRoutes}" Margin="0,0,12,0" />
                            <RadioButton Content="ECMWF IFS" GroupName="RouteModel" Command="{Binding ActivateEcmwfRouteCommand}"
                                         IsChecked="{Binding IsEcmwfRouteActive, Mode=OneWay}" IsVisible="{Binding HasEcmwfRoutes}" />
                        </WrapPanel>
                    </Grid>
                    <WrapPanel IsVisible="{Binding WeatherOnlyMode}">
                        <RadioButton Content="NOAA GFS weather" GroupName="WeatherModel" Command="{Binding ActivateNoaaWeatherCommand}"
                                     IsChecked="{Binding IsNoaaWeatherActive, Mode=OneWay}" IsVisible="{Binding HasNoaaWeather}" Margin="0,0,12,0" />
                        <RadioButton Content="ECMWF IFS weather" GroupName="WeatherModel" Command="{Binding ActivateEcmwfWeatherCommand}"
                                     IsChecked="{Binding IsEcmwfWeatherActive, Mode=OneWay}" IsVisible="{Binding HasEcmwfWeather}" />
                    </WrapPanel>
                    <Grid x:Name="TimelineControls" ColumnDefinitions="44,44,*" ColumnSpacing="8">
                        <Button x:Name="PreviousTimelineButton" Content="◀" ToolTip.Tip="Previous point" AutomationProperties.Name="Previous timeline point"
                                Command="{Binding PreviousTimelineCommand}" MinWidth="44" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <Button x:Name="NextTimelineButton" Grid.Column="1" Content="▶" ToolTip.Tip="Next point" AutomationProperties.Name="Next timeline point"
                                Command="{Binding NextTimelineCommand}" MinWidth="44" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <Slider x:Name="TimelineSlider" Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding TimelinePosition}"
                                IsEnabled="{Binding HasTimeline}" VerticalAlignment="Center" AutomationProperties.Name="Route and weather timeline" />
                    </Grid>
                    <TextBlock Text="{Binding TimelineDisplay}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding ActiveWeatherDisplay}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                    <Expander x:Name="WeatherDetailsExpander" Header="Weather legend &amp; coverage" IsExpanded="False">
                        <StackPanel Spacing="6">
                            <Grid x:Name="WeatherLegend" ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="8,Auto" ColumnSpacing="3" RowSpacing="4">
                                <Border Background="#5BC0EB" />
                                <Border Grid.Column="1" Background="#00A6A6" />
                                <Border Grid.Column="2" Background="#7FB800" />
                                <Border Grid.Column="3" Background="#F4D35E" />
                                <Border Grid.Column="4" Background="#E4572E" />
                                <Border Grid.Column="5" Background="#9B2C67" />
                                <TextBlock Grid.Row="1" Text="0" FontSize="10" TextAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="5" FontSize="10" TextAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="10" FontSize="10" TextAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="15" FontSize="10" TextAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="25" FontSize="10" TextAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="5" Text="35+ kt" FontSize="10" TextAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="{Binding WeatherLayerError}" IsVisible="{Binding WeatherLayerError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Classes="error" />
                </StackPanel>
            </Border>

            <Canvas x:Name="RouteTelemetryLayer"
                    IsVisible="False">
                <Line x:Name="RouteTelemetryConnector"
                      Stroke="{DynamicResource FocusColor}"
                      StrokeThickness="2"
                      IsHitTestVisible="False" />
                <Ellipse x:Name="RouteTelemetryAnchor"
                         Width="16"
                         Height="16"
                         Fill="{DynamicResource FocusColor}"
                         Stroke="{DynamicResource MarkerOutlineColor}"
                         StrokeThickness="3"
                         IsHitTestVisible="False" />
                <Button x:Name="RouteTelemetryCard"
                        Classes="route-telemetry"
                        Width="344"
                        Height="132"
                        Click="OnRouteTelemetryCardClicked"
                        AutomationProperties.Name="Route point telemetry"
                        AutomationProperties.HelpText="Shows route point telemetry. Click or tap to close.">
                    <Grid RowDefinitions="Auto,1,Auto,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding SelectedRoutePoint.TelemetryLabel}"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetryTime"
                                           Text="{Binding SelectedRoutePoint.TimelineTimestamp, StringFormat={}{0:dd MMM · HH:mm} UTC}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="×"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextMutedColor}"
                                       VerticalAlignment="Top" />
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{DynamicResource OverlayBorderColor}" />
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,*,*,*,*,*"
                              ColumnSpacing="6"
                              IsVisible="{Binding SelectedRoutePoint.HasBasicTelemetry}">
                            <StackPanel>
                                <TextBlock Text="BOAT"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetryBoatSpeed"
                                           Text="{Binding SelectedRoutePoint.Point.BoatSpeedKnots, StringFormat={}{0:0.0} kt}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TWS"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetryTrueWind"
                                           Text="{Binding SelectedRoutePoint.Point.TrueWindSpeedKnots, StringFormat={}{0:0.0} kt}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TWD"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetryTrueWindDirection"
                                           Text="{Binding SelectedRoutePoint.Point.TrueWindDirectionDegrees, StringFormat={}{0:0}°}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="AWS"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetryApparentWind"
                                           Text="{Binding SelectedRoutePoint.ApparentWindSpeedText}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AWA"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetryApparentWindAngle"
                                           Text="{Binding SelectedRoutePoint.ApparentWindAngleText}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="HDG"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetryHeading"
                                           Text="{Binding SelectedRoutePoint.Point.HeadingDegrees, StringFormat={}{0:0}°}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,*,*,*,*,*"
                              ColumnSpacing="6"
                              IsVisible="{Binding SelectedRoutePoint.HasEnvironmentTelemetry}">
                            <StackPanel>
                                <TextBlock Text="SOG"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetrySpeedOverGround"
                                           Text="{Binding SelectedRoutePoint.Point.Environment.SpeedOverGroundKnots, StringFormat={}{0:0.0} kt}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="COG"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetryCourseOverGround"
                                           Text="{Binding SelectedRoutePoint.Point.Environment.CourseOverGroundDegrees, StringFormat={}{0:0}°}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STW"
                                           Classes="telemetry-label" />
                                <TextBlock Text="{Binding SelectedRoutePoint.Point.BoatSpeedKnots, StringFormat={}{0:0.0} kt}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="FLAT"
                                           Classes="telemetry-label" />
                                <TextBlock x:Name="RouteTelemetryFlatWaterSpeed"
                                           Text="{Binding SelectedRoutePoint.Point.Environment.FlatWaterSpeedKnots, StringFormat={}{0:0.0} kt}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AWA"
                                           Classes="telemetry-label" />
                                <TextBlock Text="{Binding SelectedRoutePoint.ApparentWindAngleText}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="HDG"
                                           Classes="telemetry-label" />
                                <TextBlock Text="{Binding SelectedRoutePoint.Point.HeadingDegrees, StringFormat={}{0:0}°}"
                                           Classes="telemetry-value" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" IsVisible="{Binding SelectedRoutePoint.IsPlannedHold}"
                                   Text="Planned hold · no fresh native wind / motion sample" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3"
                                   Text="Tap to close"
                                   Classes="telemetry-hint"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Button>
            </Canvas>

            <Canvas x:Name="RadialMenuLayer"
                    IsVisible="False">
                <Line x:Name="RadialConnector"
                      IsVisible="False"
                      Stroke="{DynamicResource FocusColor}"
                      StrokeThickness="2"
                      IsHitTestVisible="False" />
                <Ellipse x:Name="RadialAnchor"
                         Width="10"
                         Height="10"
                         IsVisible="False"
                         Fill="{DynamicResource AccentColor}"
                         Stroke="{DynamicResource MarkerOutlineColor}"
                         StrokeThickness="2"
                         IsHitTestVisible="False" />
                <Button x:Name="AddWaypointRadialButton"
                        Classes="radial-action"
                        Click="OnAddWaypointRadialClicked"
                        IsEnabled="{Binding CanAddContextualWaypoint}"
                        ToolTip.Tip="Add an itinerary waypoint at this map point"
                        AutomationProperties.Name="Add waypoint here"
                        Content="Add waypoint"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
                <Button x:Name="SetStartRadialButton"
                        Classes="radial-action"
                        Click="OnSetStartRadialClicked"
                        ToolTip.Tip="Set passage start at this map point"
                        AutomationProperties.Name="Set start here"
                        Content="Set start"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
                <Button x:Name="SetDestinationRadialButton"
                        Classes="radial-action"
                        Click="OnSetDestinationRadialClicked"
                        ToolTip.Tip="Set passage destination at this map point"
                        AutomationProperties.Name="Set destination here"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <TextBlock Text="Set&#x0a;destination"
                               TextAlignment="Center"
                               LineHeight="16" />
                </Button>
                <Button x:Name="CalculateRadialButton"
                        Classes="radial-action primary-radial"
                        Command="{Binding ForceRecalculateCommand}"
                        Click="OnCalculateRadialClicked"
                        ToolTip.Tip="Recalculate route using the current passage plan"
                        AutomationProperties.Name="Calculate route">
                    <TextBlock Text="Calculate&#x0a;route"
                               TextAlignment="Center"
                               LineHeight="16" />
                </Button>
                <ToggleButton x:Name="RefreshWeatherRadialToggle"
                              Classes="radial-action"
                              IsChecked="{Binding UseNewestWeatherData, Mode=TwoWay}"
                              IsEnabled="{Binding IsDownloadForecast}"
                              ToolTip.Tip="Download the newest weather data on the next calculation"
                              AutomationProperties.Name="Refresh weather on next calculation"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center">
                    <TextBlock Text="Refresh&#x0a;weather"
                               TextAlignment="Center"
                               LineHeight="16" />
                </ToggleButton>
            </Canvas>
        </Grid>

        <Grid x:Name="RouteDrawer"
              Grid.Column="0" Grid.Row="1"
              IsVisible="False"
              Background="{DynamicResource SidebarBackgroundColor}">
            <Border x:Name="RouteDrawerContent"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <ScrollViewer x:Name="ResultsScrollViewer" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16"
                                Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Results &amp; progress"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Classes="muted"
                                       Text="Select a model on the chart to inspect its route, weather and timeline." TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="WeatherOnlyToggle" Content="Inspect weather independently"
                                  IsChecked="{Binding WeatherOnlyMode}"
                                  ToolTip.Tip="Inspect acquired forecasts even when no route was completed" />

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding SelectedRouteTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedRouteSummary}" Classes="muted" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                                    <Button Command="{Binding FocusSelectedLegCommand}"
                                            Content="Fit selected leg"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="Fit the selected leg without hiding route-wide context" />
                                    <Button Grid.Column="1"
                                            Command="{Binding FocusSelectedRoutePointCommand}"
                                            Content="Focus point"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="Center the selected route point" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="FORECAST RESULTS" Classes="section-title" />
                                <TextBlock Text="{Binding NoaaStatus}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EcmwfStatus}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LiveSearchStatus}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="PassageProgressPanel" Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="PASSAGE &amp; PROGRESS" Classes="section-title" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <ToggleButton x:Name="SetCurrentPositionButton" Classes="map-tool" Content="Set current position"
                                                  IsChecked="{Binding IsSettingCurrentPosition, Mode=OneWay}" Command="{Binding SetCurrentPositionCommand}"
                                                  ToolTip.Tip="Place the vessel on the map to resume mid-leg" />
                                    <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCurrentPositionCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding Itinerary.CurrentPositionDisplay}" Classes="muted" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,104" ColumnSpacing="7">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Departure date (local)" Classes="field-label" />
                                        <DatePicker x:Name="CurrentPositionDatePicker" SelectedDate="{Binding Itinerary.CurrentPositionDepartureDate}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Time (local)" Classes="field-label" />
                                        <TimePicker x:Name="CurrentPositionTimePicker" SelectedTime="{Binding Itinerary.CurrentPositionDepartureTimeOfDay}" ClockIdentifier="24HourClock" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="CurrentPositionDepartureDisplay" Classes="muted" Text="{Binding Itinerary.CurrentPositionDepartureDisplay}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Itinerary.Legs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RouteLegEditorItemViewModel">
                                            <Border Classes="subtle" Margin="0,0,0,6">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding StatusLabel}" Classes="muted" />
                                                    <TextBlock Text="{Binding OutcomeStatus}" Classes="muted" TextWrapping="Wrap" />
                                                    <WrapPanel>
                                                        <RadioButton Content="View" Command="{Binding SelectCommand}" GroupName="RouteLegSelection"
                                                                     IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip.Tip="Select this leg on the full-route map" Margin="0,0,6,0" />
                                                        <Button Content="Sailed" Command="{Binding MarkSailedCommand}" ToolTip.Tip="Mark this leg as sailed" />
                                                        <Button Content="Unmark" Command="{Binding UnmarkSailedCommand}" ToolTip.Tip="Unmark this leg as sailed" />
                                                        <Button Content="Active" Command="{Binding MakeActiveCommand}" ToolTip.Tip="Explicitly resume from this leg" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="RouteDetailsExpander"
                                  Header="Route legend"
                                  IsExpanded="False">
                            <Border Classes="card"
                                    Margin="0,8,0,0">
                                <Grid ColumnDefinitions="24,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="7">
                                    <Border Width="20"
                                            Height="4"
                                            Background="#0072B2"
                                            CornerRadius="2"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="NOAA GFS"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Row="1"
                                            Width="20"
                                            Height="4"
                                            Background="#D55E00"
                                            CornerRadius="2"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="ECMWF IFS"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="HistoricalIsochroneLegendSwatch"
                                            Grid.Row="2"
                                            Width="20"
                                            Height="2"
                                            Opacity="0.18"
                                            Background="#D32F2F"
                                            CornerRadius="2"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="Historical isochrone fronts"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="DestinationFrontLegendSwatch"
                                            Grid.Row="3"
                                            Width="20"
                                            Height="3"
                                            Opacity="0.92"
                                            Background="#D32F2F"
                                            CornerRadius="2"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="Latest isochrone front"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Row="4"
                                            Width="20"
                                            Height="3"
                                            Opacity="0.72"
                                            Background="#355866"
                                            CornerRadius="2"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="1"
                                               Text="Latest provisional route"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Expander>

                        <Expander Header="Run details">
                        <Border Classes="subtle">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding StatusMessage}"
                                           TextWrapping="Wrap"
                                           Classes="muted" />
                                <TextBlock x:Name="ResolvedRoutingSetupStatus" Text="{Binding RoutingSetup.ResolvedStatus}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedRouteDetails}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LandAvoidanceWarning}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextColor}" />
                            </StackPanel>
                        </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</Window>
